# ============================================================
# Five-a-Side Manager — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit the .env file to version control.
# ============================================================

# ----------------------------
# MongoDB Atlas
# ----------------------------
# Get from: Atlas Dashboard → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/five-a-side?retryWrites=true&w=majority

# ----------------------------
# Application
# ----------------------------
PORT=3000
NODE_ENV=production
# Your deployed frontend URL (used for CORS)
FRONTEND_URL=https://your-frontend-app.vercel.app

# ----------------------------
# JWT Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ----------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this

# ----------------------------
# Admin Seed (used by: npm run seed-admin)
# ----------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecureAdminPassword123!
ADMIN_SECURITY_ANSWER=your_override_code

# ----------------------------
# Gemini AI (Google) — AI Features 2, 3, 4
# Get from: https://aistudio.google.com/apikey
# ----------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# ----------------------------
# Cloudinary — Player Avatar Uploads
# Get from: https://cloudinary.com → Dashboard
# ----------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ----------------------------
# Gmail (Nodemailer) — Email Notifications (optional)
# ----------------------------
# 1. Turn on 2-Step Verification for your Google Account.
# 2. Go to Google Account -> Security -> App passwords.
# 3. Create a new App password and paste it here (without spaces).
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
