# MongoDB Atlas Connection String
# Get this from MongoDB Atlas dashboard: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/database-name?retryWrites=true&w=majority

# Application Port (Render/Railway will set this, but defaults to 3000)
PORT=3000

# JWT Secrets - Generate these with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-this

# Environment (development or production)
NODE_ENV=production

# Frontend URL for CORS (update with your deployed frontend URL)
FRONTEND_URL=https://your-frontend-app.vercel.app
